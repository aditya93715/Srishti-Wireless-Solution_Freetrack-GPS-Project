# ── Server Configuration ─────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=fleet_dashboard_jwt_secret_2024_enterprise
JWT_EXPIRES_IN=7d

# ── CORS Configuration ───────────────────────────────────────────────────────
# Multiple origins comma-separated (no spaces)
CORS_ORIGIN=http://localhost:5173

# ── Frontend URL (for redirects/emails) ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google Maps API Configuration ────────────────────────────────────────────
# For real-time address fetching and geocoding
GOOGLE_MAPS_API_KEY=""

# ── Real-time GPS Configuration ──────────────────────────────────────────────
# How often to broadcast live positions (in milliseconds)
# Default: 3000ms (3 seconds) for smooth real-time tracking
GPS_POLL_MS=3000

# ── Socket.IO Configuration ──────────────────────────────────────────────────
# Increased ping timeout to prevent premature disconnections (60 seconds)
SOCKET_PING_TIMEOUT=60000

# Increased ping interval for better connection stability (25 seconds)
SOCKET_PING_INTERVAL=25000

# Maximum reconnection attempts before giving up
SOCKET_RECONNECTION_ATTEMPTS=10

# Reconnection delay with exponential backoff (starts at 1 second)
SOCKET_RECONNECTION_DELAY=1000

# Maximum reconnection delay cap (5 seconds)
SOCKET_RECONNECTION_DELAY_MAX=5000

# Connection timeout for initial socket handshake (20 seconds)
SOCKET_CONNECTION_TIMEOUT=20000

# Enable WebSocket transport first, fallback to polling
SOCKET_TRANSPORTS=websocket,polling

# ── Address Cache Configuration ──────────────────────────────────────────────
# Default: 3600000ms (1 hour)
ADDRESS_CACHE_TTL=3600000

# Minimum time between Google Maps API requests (milliseconds)
GEOCODE_RATE_LIMIT_MS=200

# Number of addresses to process in parallel
GEOCODE_BATCH_SIZE=10

# ── Vehicle State Configuration ──────────────────────────────────────────────
# Speed threshold for overspeed state (km/h)
OVERSPEED_THRESHOLD=80

# Minutes after which vehicle is considered unreachable
UNREACHABLE_TIMEOUT_MINUTES=60

# ── Logging Configuration ────────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ── API Rate Limiting ────────────────────────────────────────────────────────
# Maximum requests per IP per minute
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Session Configuration ────────────────────────────────────────────────────
SESSION_SECRET=fleet_dashboard_session_secret_2024_secure
SESSION_MAX_AGE=86400000 # 24 hours in milliseconds

# ── File Upload Configuration ────────────────────────────────────────────────
MAX_FILE_SIZE=10485760 # 10MB
ALLOWED_FILE_TYPES=.xlsx,.xls,.csv

# ── Monitoring Configuration ─────────────────────────────────────────────────
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics







